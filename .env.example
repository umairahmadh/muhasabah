# The single login password.
MUHASABAH_PASSWORD=changeme

# --- SQLite (default, no DATABASE_URL set) ---
# Where the SQLite file lives. Defaults to ./muhasabah.db next to the app.
# MUHASABAH_DB=./muhasabah.db

# --- Postgres / Neon (set DATABASE_URL to activate) ---
# Get this from your Neon project dashboard → Connection string.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
